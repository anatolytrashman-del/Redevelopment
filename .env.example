# Необязательно — в src/lib/supabase.ts уже зашиты рабочие значения по умолчанию
# (URL + publishable key безопасны для клиента, доступ регулируется RLS).
# Переопределите здесь, если понадобится указать другой проект Supabase.
# Строки с ключами закомментированы: пустое значение перекрыло бы значение по умолчанию.
VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Необязательно — в DistrictMap.tsx уже зашит рабочий ключ по умолчанию
# (JS API ключ Яндекс.Карт ограничен по домену на стороне Яндекса, не секрет).
# VITE_YANDEX_MAPS_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Скрипты в scripts/ (node), не фронтенд ---
# Supabase publishable key для скриптов (scripts/lib/env.mjs). Если не задан,
# берётся VITE_SUPABASE_ANON_KEY, затем SUPABASE_ANON_KEY. Скрипты sync-*/build-market-snapshots
# при заданном SUPABASE_SERVICE_ROLE_KEY используют его и publishable key не требуют.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Ключ IndexNow (то же значение, что в имени файла public/<ключ>.txt).
# Нужен scripts/notify-indexnow.mjs (прод-сборка Vercel; без него пинг пропускается),
# scripts/indexnow-submit.mjs и scripts/indexnow-*-migration.mjs.
# INDEXNOW_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Только для локальных скриптов, НИКОГДА не в .env.example с реальным значением:
# SUPABASE_SERVICE_ROLE_KEY=
