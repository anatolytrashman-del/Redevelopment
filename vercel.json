{
  "functions": {
    "api/transcribe-meeting.js": { "maxDuration": 300 },
    "api/summarize-meeting.js": { "maxDuration": 300 },
    "api/suggest-tasks.js": { "maxDuration": 300 }
  },
  "redirects": [
    { "source": "/", "destination": "/one", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/tz/(.*)", "destination": "/tz.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
